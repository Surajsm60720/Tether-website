---
interface Props {
  mode?: 'transfer' | 'needs-you' | 'thinking';
}
const { mode = 'needs-you' } = Astro.props;
---

<div class="island" aria-hidden="true">
  {mode === 'transfer' && (
    <div class="pill">
      <span class="mark">↓</span>
      <span class="pct">62%</span>
    </div>
  )}
  {mode === 'thinking' && (
    <div class="pill">
      <span class="mark mono">&lt;/&gt;</span>
      <span>Thinking</span>
    </div>
  )}
  {mode === 'needs-you' && (
    <div class="pill alert">
      <span class="mark mono">&lt;/&gt;</span>
      <span>Needs you</span>
    </div>
  )}
</div>

<style>
  .island {
    display: flex;
    justify-content: center;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 34px;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: #000;
    color: #f5f5f7;
    font-size: 0.8rem;
    font-weight: 600;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  }

  .mark {
    color: var(--accent-bright);
  }

  .pct {
    color: var(--accent-bright);
    font-variant-numeric: tabular-nums;
  }

  .alert {
    outline: 1px solid color-mix(in srgb, var(--accent-bright) 55%, transparent);
  }
</style>
