---
interface Props {
  screen?: 'hosts' | 'files' | 'preview' | 'send' | 'terminal' | 'transfers';
  dark?: boolean;
}
const { screen = 'hosts', dark = false } = Astro.props;
---

<figure class:list={['phone', dark && 'is-dark']} data-device="phone">
  <div class="bezel">
    <div class="island" aria-hidden="true"></div>
    <div class="screen">
      {
        screen === 'hosts' && (
          <div class="ui">
            <div class="status-bar"><span>9:41</span><span class="sb-right"></span></div>
            <h4>Your Macs</h4>
            <div class="card">
              <span class="dot"></span>
              <div>
                <strong>Studio Mac</strong>
                <small>Connected</small>
              </div>
            </div>
            <div class="card muted">
              <span class="dot dim"></span>
              <div>
                <strong>Office Mac</strong>
                <small>Available</small>
              </div>
            </div>
          </div>
        )
      }
      {
        screen === 'files' && (
          <div class="ui">
            <div class="status-bar"><span>9:41</span><span class="sb-right"></span></div>
            <h4>Projects</h4>
            <div class="file">
              <span class="glyph doc"></span>
              <div>
                <strong>brief.pdf</strong>
                <small>Today · 2.4 MB</small>
              </div>
            </div>
            <div class="file">
              <span class="glyph img"></span>
              <div>
                <strong>hero.png</strong>
                <small>Yesterday · 1.1 MB</small>
              </div>
            </div>
            <div class="file">
              <span class="glyph folder"></span>
              <div>
                <strong>Exports</strong>
                <small>12 items</small>
              </div>
            </div>
          </div>
        )
      }
      {
        screen === 'preview' && (
          <div class="ui preview">
            <div class="status-bar light"><span>9:41</span><span class="sb-right"></span></div>
            <div class="pdf">
              <div class="bar"></div>
              <div class="line w80"></div>
              <div class="line w60"></div>
              <div class="line w90"></div>
              <div class="line w50"></div>
              <div class="line w70"></div>
            </div>
            <p>brief.pdf</p>
          </div>
        )
      }
      {
        screen === 'send' && (
          <div class="ui">
            <div class="status-bar"><span>9:41</span><span class="sb-right"></span></div>
            <h4>Send</h4>
            <button class="fake-btn" type="button">Photos</button>
            <button class="fake-btn secondary" type="button">Files</button>
            <p class="hint">Lands in Inbox on your Mac</p>
          </div>
        )
      }
      {
        screen === 'terminal' && (
          <div class="term">
            <div class="term-top">
              Studio Mac <span>· Live</span>
            </div>
            <pre><span class="p">studio:/Projects $</span> ls
<span class="d">Exports/</span>  brief.pdf
<span class="p">studio:/Projects $</span> <span class="cursor">█</span></pre>
          </div>
        )
      }
      {
        screen === 'transfers' && (
          <div class="ui">
            <div class="status-bar"><span>9:41</span><span class="sb-right"></span></div>
            <h4>Transfers</h4>
            <div class="xfer">
              <strong>hero.png</strong>
              <div class="meter"><i style="width:72%"></i></div>
              <small>12.4 MB/s · 8 s left</small>
            </div>
          </div>
        )
      }
    </div>
  </div>
</figure>

<style>
  .phone {
    margin: 0;
    filter: drop-shadow(0 22px 48px rgba(15, 15, 16, 0.22));
  }

  .bezel {
    border-radius: var(--radius-device);
    background: linear-gradient(160deg, #2a2a2e 0%, #111114 55%, #000 100%);
    padding: 11px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .island {
    width: 34%;
    height: 22px;
    margin: 2px auto 8px;
    background: #000;
    border-radius: 999px;
  }

  .screen {
    border-radius: 30px;
    overflow: hidden;
    background: #f2f2f4;
    aspect-ratio: 9 / 19.5;
  }

  .is-dark .screen {
    background: var(--term-bg);
    color: var(--term-fg);
  }

  .status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.58rem;
    font-weight: 700;
    margin-bottom: 0.55rem;
    color: #1d1d1f;
  }

  .status-bar.light {
    color: #1d1d1f;
  }

  .sb-right {
    width: 2.4rem;
    height: 0.55rem;
    border-radius: 999px;
    background: linear-gradient(90deg, #c7c7cc, #1d1d1f);
    opacity: 0.55;
  }

  .ui {
    padding: 0.75rem 0.8rem 1rem;
    font-size: 0.68rem;
    color: #1d1d1f;
    height: 100%;
  }

  h4 {
    margin: 0 0 0.85rem;
    font-size: 1.2rem;
    letter-spacing: -0.04em;
    font-weight: 720;
  }

  .card,
  .file,
  .xfer {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    padding: 0.65rem;
    background: rgba(255, 255, 255, 0.92);
    border-radius: 14px;
    margin-bottom: 0.45rem;
    border: 1px solid rgba(0, 0, 0, 0.04);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.8) inset;
  }

  .card.muted {
    opacity: 0.78;
  }

  .card small,
  .file small,
  .xfer small,
  .hint {
    display: block;
    color: #6e6e73;
    margin-top: 0.1rem;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 18%, transparent);
  }

  .dot.dim {
    background: #c7c7cc;
    box-shadow: none;
  }

  .preview {
    display: grid;
    align-content: start;
    justify-items: center;
    background: linear-gradient(180deg, #fff, #f2f2f4);
  }

  .pdf {
    width: 78%;
    aspect-ratio: 3 / 4;
    background: #fff;
    border-radius: 10px;
    padding: 0.85rem;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.1);
    margin-top: 0.5rem;
  }

  .bar {
    height: 8px;
    width: 42%;
    background: linear-gradient(90deg, var(--accent), var(--accent-bright));
    border-radius: 4px;
    margin-bottom: 0.85rem;
  }

  .line {
    height: 5px;
    background: #e8e8ed;
    border-radius: 3px;
    margin-bottom: 0.45rem;
  }

  .w80 {
    width: 80%;
  }
  .w60 {
    width: 60%;
  }
  .w90 {
    width: 90%;
  }
  .w50 {
    width: 50%;
  }
  .w70 {
    width: 70%;
  }

  .fake-btn {
    display: block;
    width: 100%;
    border: 0;
    border-radius: 14px;
    padding: 0.8rem;
    margin-bottom: 0.5rem;
    background: linear-gradient(180deg, #d49622, var(--accent));
    color: #fff;
    font-weight: 700;
    font-size: 0.72rem;
  }

  .fake-btn.secondary {
    background: #e8e8ed;
    color: #1d1d1f;
  }

  .term {
    height: 100%;
    padding: 0.85rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    line-height: 1.5;
  }

  .term-top {
    font-size: 0.55rem;
    color: var(--term-dim);
    margin-bottom: 0.7rem;
  }

  .term-top span {
    color: var(--term-prompt);
  }

  .term pre {
    margin: 0;
    white-space: pre-wrap;
  }

  .p {
    color: var(--term-prompt);
  }
  .d {
    color: var(--term-dir);
  }
  .cursor {
    color: var(--term-prompt);
  }

  .meter {
    flex: 1;
    height: 4px;
    background: #e5e5ea;
    border-radius: 999px;
    overflow: hidden;
  }

  .meter i {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent-bright));
  }

  .xfer {
    flex-wrap: wrap;
  }

  .xfer strong {
    width: 100%;
  }

  .glyph {
    width: 1.45rem;
    height: 1.45rem;
    border-radius: 6px;
    flex: 0 0 auto;
  }

  .glyph.doc {
    background: linear-gradient(180deg, #fff 42%, #ececf0 42%);
    border: 1px solid #d8d8de;
  }

  .glyph.img {
    background: linear-gradient(135deg, rgba(201, 138, 27, 0.35), #ececf0);
    border: 1px solid #d8d8de;
  }

  .glyph.folder {
    background: linear-gradient(180deg, #f0c05a, var(--accent));
    border: 1px solid rgba(201, 138, 27, 0.35);
  }
</style>
