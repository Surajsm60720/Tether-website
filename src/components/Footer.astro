---
import ThemeSwitcher from './ThemeSwitcher';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-brand">Tether</p>
      <p class="footer-tag">Your Mac. On your iPhone. Local by design.</p>
    </div>
    <div>
      <p class="footer-label">Docs</p>
      <ul>
        <li><a href="/docs/quick-start">Quick start</a></li>
        <li><a href="/docs/mac">Mac setup</a></li>
        <li><a href="/docs/iphone">iPhone setup</a></li>
        <li><a href="/docs/pairing">Pairing</a></li>
        <li><a href="/docs/remote">Remote</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-label">Product</p>
      <ul>
        <li><a href="/security">Security</a></li>
        <li><a href="/docs/changelog">Changelog</a></li>
        <li><a href="/journey">Journey</a></li>
        <li><a href="/download">Get Tether</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-label">Legal</p>
      <ul>
        <li>
          <a href="/docs/security#privacy">Privacy</a>
          <span class="footer-note"> — local-only core path; no account</span>
        </li>
        <li>
          <a href="https://github.com/Surajsm60720/Tether" target="_blank" rel="noopener noreferrer"
            >License / repo</a
          >
        </li>
      </ul>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <p>© {year} Tether. Built from source until App Store distribution.</p>
    <ThemeSwitcher client:load />
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--hairline);
    padding: 3.5rem 0 2.25rem;
    background:
      radial-gradient(50% 80% at 0% 0%, var(--accent-soft), transparent 55%),
      var(--surface-raised);
    color: var(--ink-secondary);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 2.25rem;
  }

  .footer-brand {
    margin: 0 0 0.45rem;
    color: var(--ink);
    font-weight: 740;
    letter-spacing: -0.04em;
    font-size: 1.25rem;
  }

  .footer-tag {
    margin: 0;
    max-width: 16rem;
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .footer-label {
    margin: 0 0 0.7rem;
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer li {
    margin: 0.4rem 0;
    font-size: 0.92rem;
  }

  .footer a {
    color: var(--ink-secondary);
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--accent-text);
  }

  .footer-note {
    color: var(--ink-tertiary);
    font-size: 0.8rem;
  }

  .footer-bottom {
    margin-top: 2.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
    font-size: 0.8rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer :global(.theme-switcher) {
    position: relative;
    flex: 0 0 auto;
  }

  .footer :global(.theme-switcher-trigger) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.35rem;
    padding: 0.35rem 0.75rem 0.35rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--hairline-strong);
    background: color-mix(in srgb, var(--surface) 55%, transparent);
    color: var(--ink);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 580;
    letter-spacing: -0.01em;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .footer :global(.theme-switcher-trigger:hover),
  .footer :global(.theme-switcher-trigger[aria-expanded='true']) {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--hairline-strong));
    background: var(--accent-soft);
  }

  .footer :global(.theme-switcher-disk) {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 999px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      0 0 0 1px rgba(0, 0, 0, 0.35);
    flex: 0 0 auto;
  }

  .footer :global(.theme-switcher-caret) {
    width: 0.45rem;
    height: 0.45rem;
    border-right: 1.5px solid var(--ink-tertiary);
    border-bottom: 1.5px solid var(--ink-tertiary);
    transform: translateY(-1px) rotate(45deg);
    margin-left: 0.1rem;
  }

  .footer :global(.theme-switcher-trigger[aria-expanded='true'] .theme-switcher-caret) {
    transform: translateY(2px) rotate(225deg);
  }

  .footer :global(.theme-palette) {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.55rem);
    z-index: 40;
    width: min(calc(100vw - 2rem), 20rem);
    padding: 0.85rem 0.9rem 0.95rem;
    border-radius: 18px;
    border: 1px solid var(--hairline-strong);
    background: color-mix(in srgb, var(--surface-raised) 96%, transparent);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.06) inset,
      0 18px 50px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(18px) saturate(1.2);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    animation: theme-palette-in 0.16s var(--ease-out);
  }

  .footer :global(.theme-palette-title) {
    margin: 0 0 0.65rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-tertiary);
  }

  .footer :global(.theme-palette-row) {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.25rem;
  }

  .footer :global(.theme-swatch) {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.15rem 0.3rem;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--ink-secondary);
    font: inherit;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .footer :global(.theme-swatch:hover) {
    background: rgba(242, 238, 230, 0.06);
    color: var(--ink);
  }

  .footer :global(.theme-swatch.is-selected) {
    color: var(--ink);
  }

  .footer :global(.theme-swatch-disk) {
    width: 1.45rem;
    height: 1.45rem;
    border-radius: 999px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      0 0 0 1px rgba(0, 0, 0, 0.35);
    transition:
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .footer :global(.theme-swatch.is-selected .theme-swatch-disk) {
    transform: scale(1.05);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.4),
      0 0 0 2px var(--surface-raised),
      0 0 0 3.5px var(--accent);
  }

  .footer :global(.theme-swatch-name) {
    font-size: 0.65rem;
    font-weight: 580;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  @keyframes theme-palette-in {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer :global(.theme-palette) {
      animation: none;
    }
  }

  @media (max-width: 800px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
