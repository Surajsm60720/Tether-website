---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getCollection, render } from 'astro:content';

const all = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const indexEntry = all.find((d) => d.id === 'index' || d.id.endsWith('/index'));
const { Content } = indexEntry ? await render(indexEntry) : { Content: null };
const rest = all.filter((d) => d.id !== 'index' && !d.id.endsWith('/index'));
---

<DocsLayout
  title={indexEntry?.data.title ?? 'Docs'}
  description={indexEntry?.data.description ?? 'Start here — install, pair, browse, and go deeper when you need to.'}
>
  {Content && <Content />}
  <div class="docs-index-grid">
    {
      rest.map((doc) => (
        <a href={`/docs/${doc.id}`}>
          <h3>{doc.data.title}</h3>
          <p>{doc.data.description}</p>
        </a>
      ))
    }
  </div>
</DocsLayout>
