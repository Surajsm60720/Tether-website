---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/marketing.css';
---

<BaseLayout
  title="Features"
  description="Browse, send, preview, terminal, agents, and monitor — two modes on one local connection."
>
  <section class="section" style="padding-top:calc(var(--nav-h) + 3rem)">
    <div class="wrap">
      <p class="eyebrow">Features</p>
      <h1 class="h2">Everything on one local connection</h1>
      <p class="lead">
        Casual browsing and a power-user terminal share the same pairing. No cloud account in the middle.
      </p>

      <div class="feature-list">
        <article>
          <h2>Browse &amp; preview</h2>
          <p>
            List or grid shared folders, search by name, sort, download, and open files in QuickLook.
          </p>
          <a href="/docs/files">Files docs</a>
        </article>
        <article>
          <h2>Send, Inbox, Shelf</h2>
          <p>
            Push photos and files from the phone into a Mac Inbox. Drag them out from the floating Shelf.
          </p>
          <a href="/docs/send">Send docs</a>
        </article>
        <article>
          <h2>Terminal</h2>
          <p>
            Everyday file commands inside shares. Not a general Mac shell — on purpose.
          </p>
          <a href="/docs/terminal">Terminal docs</a>
        </article>
        <article>
          <h2>Live agents</h2>
          <p>
            Allowlisted CLIs open a live PTY. The phone is the screen and keyboard; the Island shows status.
          </p>
          <a href="/docs/agents">Agents docs</a>
        </article>
        <article>
          <h2>Monitor</h2>
          <p>fetch for a Mac portrait; htop for a live resource view.</p>
          <a href="/docs/monitor">Monitor docs</a>
        </article>
        <article>
          <h2>Other networks</h2>
          <p>
            After you pair on Wi‑Fi, reach the Mac with Tailscale, a saved address, or a small relay.
          </p>
          <a href="/docs/remote">Remote docs</a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .feature-list {
    margin-top: 3rem;
    display: grid;
    gap: 0;
  }

  .feature-list article {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--hairline);
  }

  .feature-list h2 {
    margin: 0 0 0.45rem;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }

  .feature-list p {
    margin: 0 0 0.65rem;
    max-width: 38rem;
    color: var(--ink-secondary);
  }

  .feature-list a {
    font-size: 0.925rem;
    font-weight: 560;
    text-decoration: none;
  }
</style>
