---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/marketing.css';
import PhoneFrame from '../components/PhoneFrame';
import HeroLoop from '../components/HeroLoop';
---

<BaseLayout title="Tether">
  <!-- Hero -->
  <section class="hero" aria-label="Tether">
    <div class="hero-solo">
      <HeroLoop client:idle />
      <h1>Your Mac. On your iPhone.</h1>
      <p class="hero-support">
        Browse files. Send photos. Run a terminal. All local — no cloud, no passwords to type.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#moment">See the moment</a>
        <a class="btn btn-secondary" href="#power">For power users</a>
      </div>
      <a class="quiet-link" href="/docs">Read the docs</a>
    </div>
  </section>

  <!-- Story: familiar moment (problem only → flows into The gap) -->
  <section class="section moment" id="moment" data-chapter="moment" aria-labelledby="moment-heading">
    <div class="wrap moment-wrap">
      <div class="moment-copy">
        <p class="eyebrow">A familiar moment</p>
        <h2 class="h2" id="moment-heading">Ever needed a file stuck on the Mac in the other room?</h2>
        <p class="lead">
          You’re on the couch with your phone. The PDF, the photo, the export — it’s sitting on the laptop.
          Or an agent is mid-run and you need the Mac awake while you step away. What now?
        </p>
        <ul class="moment-frictions">
          <li>
            <strong>The file is there. You’re not.</strong>
            <span>AirDrop needs both devices in reach — and it won’t let you browse the disk.</span>
          </li>
          <li>
            <strong>You want a preview, not another upload.</strong>
            <span>Cloud sync means waiting, and trusting another account, for something already local.</span>
          </li>
          <li>
            <strong>The Mac has to stay awake.</strong>
            <span>Emailing yourself won’t help a live agent — and closing the lid usually means sleep.</span>
          </li>
        </ul>
      </div>

      <div class="moment-visual" data-story-media="stuck" aria-hidden="true">
        <div class="story-scene story-stuck">
          <div class="story-stuck-stage">
            <div class="story-mac">
              <span class="story-mac-screen">
                <i class="story-file-chip">brief.pdf</i>
              </span>
              <span class="story-mac-base"></span>
            </div>
            <svg class="story-gap-path" viewBox="0 0 120 40" fill="none">
              <path
                class="story-gap-dash"
                d="M8 20c18-14 36-14 54 0s36 14 50 0"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-dasharray="4 6"
              ></path>
              <circle class="story-gap-dot" cx="8" cy="20" r="2.5" fill="var(--accent)"></circle>
              <text x="48" y="38" class="story-gap-label">out of reach</text>
            </svg>
            <div class="story-phone">
              <span class="story-phone-screen">
                <i class="story-phone-miss">?</i>
              </span>
            </div>
          </div>
          <p class="story-caption">Same home. Different rooms. No easy path.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="section problem moment-continues" aria-labelledby="gap-heading">
    <div class="wrap">
      <p class="eyebrow">The gap</p>
      <h2 class="h2" id="gap-heading">Why the usual options fall short</h2>
      <p class="lead">
        That stuck feeling isn’t rare — it’s the default. Here’s how the common paths compare, and where a
        shorter one fits.
      </p>

      <div class="gap-compare" role="table" aria-label="How Tether compares">
        <div class="gap-compare-row gap-compare-head" role="row">
          <div class="gap-compare-cell gap-compare-label" role="columnheader">Need</div>
          <div class="gap-compare-cell" role="columnheader">AirDrop</div>
          <div class="gap-compare-cell" role="columnheader">iCloud</div>
          <div class="gap-compare-cell" role="columnheader">SMB / SSH</div>
          <div class="gap-compare-cell gap-compare-tether" role="columnheader">Tether</div>
        </div>

        <div class="gap-compare-row" role="row">
          <div class="gap-compare-cell gap-compare-label" role="rowheader">
            <span class="gap-need-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                <path d="M4 8.2 11.2 4.6a1.6 1.6 0 0 1 1.6 0L20 8.2v9.4a1.8 1.8 0 0 1-1.8 1.8H5.8A1.8 1.8 0 0 1 4 17.6V8.2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
                <path d="M9.2 19.4V12h5.6v7.4" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
              </svg>
            </span>
            Browse folders
          </div>
          <div class="gap-compare-cell" role="cell"><span class="gap-miss">No</span></div>
          <div class="gap-compare-cell" role="cell"><span class="gap-soft">Cloud only</span></div>
          <div class="gap-compare-cell" role="cell"><span class="gap-fit">Yes</span></div>
          <div class="gap-compare-cell gap-compare-tether" role="cell"><span class="gap-fit">Yes</span></div>
        </div>

        <div class="gap-compare-row" role="row">
          <div class="gap-compare-cell gap-compare-label" role="rowheader">
            <span class="gap-need-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                <path d="M12 4.5c3.1 0 5.6 2.1 5.6 5.4 0 4.2-5.6 9.6-5.6 9.6S6.4 14.1 6.4 9.9c0-3.3 2.5-5.4 5.6-5.4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
                <circle cx="12" cy="9.8" r="1.7" stroke="currentColor" stroke-width="1.6"></circle>
              </svg>
            </span>
            Stay local
          </div>
          <div class="gap-compare-cell" role="cell"><span class="gap-fit">Yes</span></div>
          <div class="gap-compare-cell" role="cell"><span class="gap-miss">Uploads</span></div>
          <div class="gap-compare-cell" role="cell"><span class="gap-fit">Yes</span></div>
          <div class="gap-compare-cell gap-compare-tether" role="cell"><span class="gap-fit">Yes</span></div>
        </div>

        <div class="gap-compare-row" role="row">
          <div class="gap-compare-cell gap-compare-label" role="rowheader">
            <span class="gap-need-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                <rect x="5" y="10.5" width="14" height="9.5" rx="2.2" stroke="currentColor" stroke-width="1.6"></rect>
                <path d="M8.2 10.5V8.1a3.8 3.8 0 0 1 7.6 0v2.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
              </svg>
            </span>
            No passwords to type
          </div>
          <div class="gap-compare-cell" role="cell"><span class="gap-fit">Yes</span></div>
          <div class="gap-compare-cell" role="cell"><span class="gap-soft">Account</span></div>
          <div class="gap-compare-cell" role="cell"><span class="gap-miss">IP + creds</span></div>
          <div class="gap-compare-cell gap-compare-tether" role="cell"><span class="gap-fit">QR pair</span></div>
        </div>

        <div class="gap-compare-row" role="row">
          <div class="gap-compare-cell gap-compare-label" role="rowheader">
            <span class="gap-need-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                <rect x="7.2" y="3.8" width="9.6" height="16.4" rx="2.2" stroke="currentColor" stroke-width="1.6"></rect>
                <path d="M10 7.2h4M11.2 17.8h1.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                <path d="M9.4 10.2h5.2v4.4H9.4z" stroke="currentColor" stroke-width="1.4"></path>
              </svg>
            </span>
            Preview on phone
          </div>
          <div class="gap-compare-cell" role="cell"><span class="gap-soft">After send</span></div>
          <div class="gap-compare-cell" role="cell"><span class="gap-fit">Yes</span></div>
          <div class="gap-compare-cell" role="cell"><span class="gap-soft">App-dependent</span></div>
          <div class="gap-compare-cell gap-compare-tether" role="cell"><span class="gap-fit">QuickLook</span></div>
        </div>
      </div>

      <div class="gap-path" aria-label="How Tether pairs">
        <p class="gap-path-lead">Tether’s path stays short on purpose.</p>
        <ol class="gap-steps">
          <li class="gap-step">
            <div class="gap-step-visual" aria-hidden="true">
              <svg viewBox="0 0 88 64" width="88" height="64" fill="none">
                <rect x="8" y="18" width="34" height="24" rx="3.5" stroke="currentColor" stroke-width="1.5"></rect>
                <rect x="11" y="21.5" width="28" height="15" rx="1.5" fill="currentColor" opacity="0.08"></rect>
                <path d="M20 46h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                <rect x="52" y="14" width="22" height="36" rx="4" stroke="currentColor" stroke-width="1.5"></rect>
                <rect x="55.5" y="19" width="15" height="24" rx="1.5" fill="currentColor" opacity="0.08"></rect>
                <path d="M60.5 45.5h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
                <path d="M42 30c3.2-3.5 7.2-5.4 11.5-5.4" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" opacity="0.9"></path>
                <path d="M42 34c2.4-2.2 5.2-3.4 8.2-3.4" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" opacity="0.55"></path>
                <circle cx="42" cy="32" r="2" fill="var(--accent)"></circle>
              </svg>
            </div>
            <h3>Discover</h3>
            <p>Nearby Macs running Tether Host show up on the same Wi‑Fi.</p>
          </li>
          <li class="gap-step">
            <div class="gap-step-visual" aria-hidden="true">
              <svg viewBox="0 0 88 64" width="88" height="64" fill="none">
                <rect x="10" y="12" width="36" height="40" rx="4" stroke="currentColor" stroke-width="1.5"></rect>
                <rect x="15" y="18" width="26" height="26" rx="2" stroke="var(--accent)" stroke-width="1.4"></rect>
                <path d="M19 22h7v7h-7V22Zm11 0h7v7h-7V22ZM19 33h7v7h-7v-7Zm14 3h4v4h-4v-4Zm-3-3h4v7h-4v-7Z" fill="var(--accent)"></path>
                <rect x="54" y="16" width="22" height="36" rx="4" stroke="currentColor" stroke-width="1.5"></rect>
                <circle cx="65" cy="28" r="7" stroke="var(--accent)" stroke-width="1.4"></circle>
                <path d="M65 24.8v6.4M61.8 28h6.4" stroke="var(--accent)" stroke-width="1.3" stroke-linecap="round"></path>
                <path d="M60.5 45.5h9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
              </svg>
            </div>
            <h3>Scan QR</h3>
            <p>Approve once on the Mac. Keys land in Keychain — nothing to type.</p>
          </li>
          <li class="gap-step">
            <div class="gap-step-visual" aria-hidden="true">
              <svg viewBox="0 0 88 64" width="88" height="64" fill="none">
                <rect x="6" y="16" width="32" height="28" rx="3.5" stroke="currentColor" stroke-width="1.5"></rect>
                <path d="M11 23h12M11 28h18M11 33h9" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" opacity="0.55"></path>
                <rect x="12" y="37" width="8" height="3" rx="1" fill="var(--accent)" opacity="0.85"></rect>
                <rect x="48" y="10" width="28" height="44" rx="5" stroke="currentColor" stroke-width="1.5"></rect>
                <rect x="52" y="16" width="20" height="30" rx="2" fill="currentColor" opacity="0.06"></rect>
                <path d="M55 21h14M55 26h10M55 31h12" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" opacity="0.5"></path>
                <rect x="55" y="36" width="9" height="6" rx="1.2" stroke="var(--accent)" stroke-width="1.3"></rect>
                <path d="M58.5 52h7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
                <path d="M38 30h8" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round"></path>
              </svg>
            </div>
            <h3>Browse</h3>
            <p>Open shared folders, preview files, send photos, or drop into a scoped terminal.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- Casual -->
  <section class="section path" id="casual" data-chapter="casual">
    <div class="wrap">
      <p class="eyebrow">Everyday use</p>
      <h2 class="h2">Browse your Mac like it’s in your pocket</h2>
      <p class="lead">
        Open a PDF. Preview a video. Send photos into an Inbox you can drag out on the Mac.
      </p>

      <div class="path-pin"><div class="path-sticky" data-sticky-path>
        <div class="path-steps">
          <div class="path-step is-active" data-path-step>
            <h3>Tap your Mac</h3>
            <p>Paired hosts show up nearby. One tap opens the shared folders.</p>
          </div>
          <div class="path-step" data-path-step>
            <h3>Open a PDF</h3>
            <p>QuickLook handles photos, video, audio, PDF, and the rest QuickLook supports.</p>
          </div>
          <div class="path-step" data-path-step>
            <h3>Send a photo</h3>
            <p>Send tab or Share sheet → Inbox on the Mac. Shelf for drag-out.</p>
          </div>
        </div>
        <div class="path-scene">
          <div class="path-frame" data-path-frame style="opacity:1">
            <PhoneFrame client:visible screen="hosts" />
          </div>
          <div class="path-frame" data-path-frame style="opacity:0">
            <PhoneFrame client:visible screen="preview" />
          </div>
          <div class="path-frame" data-path-frame style="opacity:0">
            <PhoneFrame client:visible screen="send" />
          </div>
          <div class="path-progress" data-path-progress><span></span></div>
        </div>
      </div></div>
    </div>
  </section>

  <!-- Power -->
  <section class="section path" id="power" data-chapter="power">
    <div class="wrap">
      <p class="eyebrow">Power users</p>
      <h2 class="h2">A terminal that knows its place</h2>
      <p class="lead">
        Everyday commands stay inside shared folders. Allowlisted agents run live on the Mac — your phone
        is the screen and keyboard.
      </p>

      <div class="path-pin"><div class="path-sticky" data-sticky-path>
        <div class="path-steps">
          <div class="path-step is-active" data-path-step>
            <h3>Virtual terminal</h3>
            <p>ls, cat, find, and the rest — scoped to the folders you shared.</p>
          </div>
          <div class="path-step" data-path-step>
            <h3>fetch and htop</h3>
            <p>A short Mac portrait and a live monitor without a general shell.</p>
          </div>
          <div class="path-step" data-path-step>
            <h3>Agents + Island</h3>
            <p>Allowlisted CLIs stream to the phone. Dynamic Island says when it needs you.</p>
          </div>
        </div>
        <div class="path-scene">
          <div class="path-frame" data-path-frame style="opacity:1">
            <PhoneFrame client:visible screen="terminal" dark />
          </div>
          <div class="path-frame" data-path-frame style="opacity:0">
            <PhoneFrame client:visible screen="monitor" dark />
          </div>
          <div class="path-frame" data-path-frame style="opacity:0">
            <PhoneFrame client:visible screen="agent" dark />
          </div>
          <div class="path-progress" data-path-progress><span></span></div>
        </div>
      </div></div>
    </div>
  </section>

  <!-- Setup -->
  <section class="section" id="setup">
    <div class="wrap">
      <p class="eyebrow">Setup</p>
      <h2 class="h2">Pair once. Open again in two taps.</h2>
      <p class="lead">Under a minute the first time. After that, tap the Mac and go.</p>

      <ol class="setup-track" aria-label="Setup in four steps">
        <li class="setup-step" data-setup-step>
          <div class="setup-visual" aria-hidden="true">
            <span class="setup-num">1</span>
            <svg viewBox="0 0 120 88" width="120" height="88" fill="none">
              <!-- Mac + menu-bar host -->
              <rect x="18" y="22" width="64" height="42" rx="5" stroke="currentColor" stroke-width="1.5"></rect>
              <rect x="22" y="26" width="56" height="28" rx="2" fill="currentColor" opacity="0.06"></rect>
              <path d="M40 70h20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              <rect x="28" y="28" width="44" height="7" rx="1.5" fill="currentColor" opacity="0.1"></rect>
              <circle cx="33" cy="31.5" r="1.6" fill="var(--accent)"></circle>
              <path d="M38 31.5h10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.45"></path>
              <rect x="78" y="14" width="28" height="22" rx="5" stroke="var(--accent)" stroke-width="1.4"></rect>
              <path d="M84 21h10M84 25h7" stroke="var(--accent)" stroke-width="1.25" stroke-linecap="round"></path>
              <path d="M82 30h14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.4"></path>
            </svg>
          </div>
          <h3>Install on your Mac</h3>
          <p>Build Host from source. It lives in the menu bar.</p>
        </li>
        <li class="setup-step" data-setup-step>
          <div class="setup-visual" aria-hidden="true">
            <span class="setup-num">2</span>
            <svg viewBox="0 0 120 88" width="120" height="88" fill="none">
              <!-- Shared folder pick -->
              <path
                d="M30 30h18l6 6h36c2.2 0 4 1.8 4 4v28c0 2.2-1.8 4-4 4H30c-2.2 0-4-1.8-4-4V34c0-2.2 1.8-4 4-4Z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"
              ></path>
              <path d="M26 42h68" stroke="currentColor" stroke-width="1.3" opacity="0.35"></path>
              <rect x="36" y="50" width="28" height="4" rx="1.5" fill="currentColor" opacity="0.2"></rect>
              <rect x="36" y="58" width="18" height="4" rx="1.5" fill="currentColor" opacity="0.12"></rect>
              <circle cx="86" cy="56" r="11" fill="var(--surface)" stroke="var(--accent)" stroke-width="1.4"></circle>
              <path d="M81.5 56.2l3 3 6.2-6.5" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
          <h3>Share a folder</h3>
          <p>Nothing is visible until you choose it. Uploads are opt-in.</p>
        </li>
        <li class="setup-step" data-setup-step>
          <div class="setup-visual" aria-hidden="true">
            <span class="setup-num">3</span>
            <svg viewBox="0 0 120 88" width="120" height="88" fill="none">
              <!-- Mac QR + phone scan (dark, not a white box) -->
              <rect x="10" y="18" width="48" height="52" rx="5" stroke="currentColor" stroke-width="1.5"></rect>
              <rect x="16" y="24" width="36" height="36" rx="3" stroke="var(--accent)" stroke-width="1.25" fill="var(--surface)"></rect>
              <rect x="20" y="28" width="8" height="8" rx="1" fill="var(--accent)"></rect>
              <rect x="40" y="28" width="8" height="8" rx="1" fill="var(--accent)"></rect>
              <rect x="20" y="48" width="8" height="8" rx="1" fill="var(--accent)"></rect>
              <rect x="32" y="36" width="4" height="4" fill="var(--accent)" opacity="0.85"></rect>
              <rect x="40" y="44" width="4" height="4" fill="var(--accent)" opacity="0.7"></rect>
              <rect x="28" y="48" width="4" height="4" fill="var(--accent)" opacity="0.55"></rect>
              <rect x="40" y="52" width="8" height="4" fill="var(--accent)" opacity="0.45"></rect>
              <rect x="68" y="14" width="34" height="58" rx="6" stroke="currentColor" stroke-width="1.5"></rect>
              <rect x="73" y="22" width="24" height="38" rx="2" fill="currentColor" opacity="0.06"></rect>
              <circle cx="85" cy="34" r="7" stroke="var(--accent)" stroke-width="1.35"></circle>
              <path d="M85 30.8v6.4M81.8 34h6.4" stroke="var(--accent)" stroke-width="1.25" stroke-linecap="round"></path>
              <path d="M78 64h14" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" opacity="0.45"></path>
              <path d="M58 40h8" stroke="var(--accent)" stroke-width="1.4" stroke-linecap="round"></path>
            </svg>
          </div>
          <h3>Scan the QR</h3>
          <p>Approve once. Keys land in Keychain — nothing to type.</p>
        </li>
        <li class="setup-step" data-setup-step>
          <div class="setup-visual" aria-hidden="true">
            <span class="setup-num">4</span>
            <svg viewBox="0 0 120 88" width="120" height="88" fill="none">
              <!-- Phone browsing shares -->
              <rect x="38" y="8" width="44" height="72" rx="8" stroke="currentColor" stroke-width="1.5"></rect>
              <rect x="44" y="16" width="32" height="50" rx="2.5" fill="currentColor" opacity="0.05"></rect>
              <circle cx="49" cy="22" r="2.2" fill="var(--accent)"></circle>
              <path d="M55 22h14" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" opacity="0.5"></path>
              <rect x="46" y="30" width="28" height="10" rx="2" stroke="currentColor" stroke-width="1.2" opacity="0.55"></rect>
              <rect x="46" y="44" width="28" height="10" rx="2" stroke="currentColor" stroke-width="1.2" opacity="0.4"></rect>
              <rect x="46" y="58" width="18" height="4" rx="1.5" fill="var(--accent)" opacity="0.85"></rect>
              <path d="M55 74h10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" opacity="0.45"></path>
            </svg>
          </div>
          <h3>Browse</h3>
          <p>Open the app, tap your Mac, and you’re in the shares.</p>
        </li>
      </ol>
      <div class="inline-links">
        <a class="btn btn-primary" href="/docs/quick-start">Quick start</a>
        <a class="quiet-link" href="/docs/pairing">Pairing details</a>
      </div>
    </div>
  </section>

  <!-- Trust -->
  <section class="section" id="trust">
    <div class="wrap trust-wrap">
      <div class="trust-intro">
        <p class="eyebrow">Trust</p>
        <h2 class="h2">Local by design</h2>
        <p class="lead">
          No account. No cloud sync. Encrypted with the key from pairing. You choose the folders; you can
          revoke a phone anytime.
        </p>
        <div class="inline-links">
          <a class="btn btn-primary" href="/docs/security">Security overview</a>
          <a class="quiet-link" href="/docs/security#privacy">Privacy</a>
        </div>
      </div>
      <ul class="trust-list">
        <li>
          <strong>Encrypted channel</strong>
          <span>Session crypto from the pairing key. No third-party crypto libraries.</span>
        </li>
        <li>
          <strong>Keychain keys</strong>
          <span>Device keys stay in the Keychain on Mac and iPhone.</span>
        </li>
        <li>
          <strong>Scoped shares</strong>
          <span>Only the folders you pick. Path escapes are rejected.</span>
        </li>
        <li>
          <strong>Approve and revoke</strong>
          <span>Every phone is explicit. Revoke deletes that phone’s key.</span>
        </li>
      </ul>
    </div>
