---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/marketing.css';
import PhoneFrame from '../components/PhoneFrame.astro';
import IslandChip from '../components/IslandChip.astro';
import HeroLoop from '../components/HeroLoop';
---

<BaseLayout title="Tether">
  <!-- Hero -->
  <section class="hero" aria-label="Tether">
    <div class="hero-solo">
      <HeroLoop client:load />
      <h1>Your Mac. On your iPhone.</h1>
      <p class="hero-support">
        Browse files. Send photos. Run a terminal. All local — no cloud, no passwords to type.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#casual">For everyday use</a>
        <a class="btn btn-secondary" href="#power">For power users</a>
      </div>
      <a class="quiet-link" href="/docs">Read the docs</a>
    </div>
  </section>

  <!-- Problem -->
  <section class="section-tight problem">
    <div class="wrap">
      <p class="eyebrow">The gap</p>
      <h2 class="h2">AirDrop can’t browse. The alternatives ask for too much.</h2>
      <p class="lead">
        iCloud needs the cloud. SMB and SSH need IPs and credentials. Tether keeps it local: discover,
        scan a QR code, done.
      </p>
      <div class="problem-flow" aria-label="Setup flow">
        <span><strong>Discover</strong></span>
        <span class="problem-arrow" aria-hidden="true">→</span>
        <span><strong>QR</strong></span>
        <span class="problem-arrow" aria-hidden="true">→</span>
        <span><strong>Done</strong></span>
      </div>
    </div>
  </section>

  <!-- Casual -->
  <section class="section path" id="casual" data-chapter="casual">
    <div class="wrap">
      <p class="eyebrow">Everyday use</p>
      <h2 class="h2">Browse your Mac like it’s in your pocket</h2>
      <p class="lead">
        Open a PDF. Preview a video. Send photos into an Inbox you can drag out on the Mac.
      </p>

      <div class="path-pin"><div class="path-sticky" data-sticky-path>
        <div class="path-steps">
          <div class="path-step is-active" data-path-step>
            <h3>Tap your Mac</h3>
            <p>Paired hosts show up nearby. One tap opens the shared folders.</p>
          </div>
          <div class="path-step" data-path-step>
            <h3>Open a PDF</h3>
            <p>QuickLook handles photos, video, audio, PDF, and the rest QuickLook supports.</p>
          </div>
          <div class="path-step" data-path-step>
            <h3>Send a photo</h3>
            <p>Send tab or Share sheet → Inbox on the Mac. Shelf for drag-out.</p>
          </div>
        </div>
        <div class="path-scene">
          <div class="path-frame" data-path-frame style="opacity:1">
            <PhoneFrame screen="hosts" />
          </div>
          <div class="path-frame" data-path-frame style="opacity:0">
            <PhoneFrame screen="preview" />
          </div>
          <div class="path-frame" data-path-frame style="opacity:0">
            <PhoneFrame screen="send" />
          </div>
          <div class="path-progress" data-path-progress><span></span></div>
        </div>
      </div></div>
    </div>
  </section>

  <!-- Power -->
  <section class="section path" id="power" data-chapter="power">
    <div class="wrap">
      <p class="eyebrow">Power users</p>
      <h2 class="h2">A terminal that knows its place</h2>
      <p class="lead">
        Everyday commands stay inside shared folders. Allowlisted agents run live on the Mac — your phone
        is the screen and keyboard.
      </p>

      <div class="path-pin"><div class="path-sticky" data-sticky-path>
        <div class="path-steps">
          <div class="path-step is-active" data-path-step>
            <h3>Virtual terminal</h3>
            <p>ls, cat, find, and the rest — scoped to the folders you shared.</p>
          </div>
          <div class="path-step" data-path-step>
            <h3>fetch and htop</h3>
            <p>A short Mac portrait and a live monitor without a general shell.</p>
          </div>
          <div class="path-step" data-path-step>
            <h3>Agents + Island</h3>
            <p>Allowlisted CLIs stream to the phone. Dynamic Island says when it needs you.</p>
          </div>
        </div>
        <div class="path-scene">
          <div class="path-frame" data-path-frame style="opacity:1">
            <PhoneFrame screen="terminal" dark />
          </div>
          <div class="path-frame" data-path-frame style="opacity:0">
            <div style="display:grid;gap:1rem;justify-items:center">
              <PhoneFrame screen="terminal" dark />
            </div>
          </div>
          <div class="path-frame" data-path-frame style="opacity:0">
            <div style="display:grid;gap:1.25rem;justify-items:center;width:min(100%,280px)">
              <IslandChip mode="needs-you" />
              <img
                src="/images/lab/11-transfer-and-thinking.png"
                alt=""
                width="280"
                height="160"
                loading="lazy"
                style="border-radius:16px;width:100%;height:auto;object-fit:cover"
              />
            </div>
          </div>
          <div class="path-progress" data-path-progress><span></span></div>
        </div>
      </div></div>
    </div>
  </section>

  <!-- Setup -->
  <section class="section" id="setup">
    <div class="wrap">
      <p class="eyebrow">Setup</p>
      <h2 class="h2">Pair once. Open again in two taps.</h2>
      <p class="lead">Under a minute the first time. After that, tap the Mac and go.</p>

      <div class="setup-track" style="margin-top:2rem">
        <div class="setup-step" data-setup-step>
          <div class="setup-num">1</div>
          <div>
            <h3>Install on your Mac</h3>
            <p>Build Tether Host from source and keep it in the menu bar.</p>
          </div>
        </div>
        <div class="setup-step" data-setup-step>
          <div class="setup-num">2</div>
          <div>
            <h3>Share a folder</h3>
            <p>Nothing is visible until you choose it. Uploads are opt-in per folder.</p>
          </div>
        </div>
        <div class="setup-step" data-setup-step>
          <div class="setup-num">3</div>
          <div style="display:flex;gap:1.25rem;align-items:center;flex-wrap:wrap">
            <div>
              <h3>Scan the QR</h3>
              <p>Approve on the Mac. Keys land in Keychain — not in a password you type.</p>
            </div>
            <div class="qr-pulse" aria-hidden="true"></div>
          </div>
        </div>
        <div class="setup-step" data-setup-step>
          <div class="setup-num">4</div>
          <div>
            <h3>Browse</h3>
            <p>Open the iPhone app, tap your Mac, and you’re in the shares.</p>
          </div>
        </div>
      </div>
      <div class="inline-links">
        <a class="btn btn-primary" href="/docs/quick-start">Quick start</a>
        <a class="quiet-link" href="/docs/pairing">Pairing details</a>
      </div>
    </div>
  </section>

  <!-- Trust -->
  <section class="section" id="trust">
    <div class="wrap">
      <p class="eyebrow">Trust</p>
      <h2 class="h2">Local by design</h2>
      <p class="lead">
        No account. No cloud sync. Encrypted with the key from pairing. You choose the folders; you can
        revoke a phone anytime.
      </p>
      <ul class="trust-list">
        <li>
          <strong>Encrypted channel</strong>
          <span>Session crypto from the pairing key. No third-party crypto libraries.</span>
        </li>
        <li>
          <strong>Keychain keys</strong>
          <span>Device keys stay in the Keychain on Mac and iPhone.</span>
        </li>
        <li>
          <strong>Scoped shares</strong>
          <span>Only the folders you pick. Path escapes are rejected.</span>
        </li>
        <li>
          <strong>Approve and revoke</strong>
          <span>Every phone is explicit. Revoke deletes that phone’s key.</span>
        </li>
      </ul>
      <div class="inline-links">
        <a class="btn btn-secondary" href="/security">Security overview</a>
        <a class="quiet-link" href="/docs/security">Deep dive in docs</a>
      </div>
    </div>
  </section>

  <!-- Bento -->
  <section class="section-tight">
    <div class="wrap">
      <p class="eyebrow">Proof</p>
      <h2 class="h2">Two ways in. One local connection.</h2>
      <div class="bento">
        <div>
          <h3>Local only</h3>
          <p>Core path stays on your Wi‑Fi. No account required.</p>
        </div>
        <div>
          <h3>QR pair</h3>
          <p>One scan, Mac approval, then reconnect without typing a password.</p>
        </div>
        <div>
          <h3>GUI + Terminal</h3>
          <p>Browse like Files, or drop into a prompt that knows its place.</p>
        </div>
        <div>
          <h3>QuickLook</h3>
          <p>Native preview for the types QuickLook already handles.</p>
        </div>
        <div>
          <h3>Inbox / Shelf</h3>
          <p>Send from the phone; drag out on the Mac.</p>
        </div>
        <div>
          <h3>Agents</h3>
          <p>Allowlisted CLIs only — honest about the boundary, not a general shell.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Journey teaser -->
  <section class="section journey-teaser">
    <div class="wrap">
      <p class="eyebrow">Journey</p>
      <h2 class="h2">From meetup slice to 3.2</h2>
      <p class="lead">
        An engineering diary of what shipped: pairing, files, terminal, Send, agents, and what is still
        out of scope.
      </p>
      <div class="inline-links">
        <a class="btn btn-secondary" href="/journey">Read the journey</a>
        <a class="quiet-link" href="/docs/changelog">Changelog</a>
      </div>
    </div>
  </section>

  <!-- Get Tether -->
  <section class="section get-tether" id="download">
    <div class="wrap">
      <p class="eyebrow">Get Tether</p>
      <h2 class="h2">Build from source today</h2>
      <p class="lead">
        App Store and TestFlight builds are not ready yet. Clone the repo, open the Xcode project, and
        run Host + Client on your devices.
      </p>
      <div class="inline-links">
        <a class="btn btn-primary" href="/download">Get Tether</a>
        <a class="btn btn-secondary" href="/docs/quick-start">Quick start</a>
        <a
          class="quiet-link"
          href="https://github.com/Surajsm60720/Tether"
          target="_blank"
          rel="noopener noreferrer">GitHub</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
